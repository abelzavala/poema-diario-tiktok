# ─────────────────────────────────────────────────────────────
#  LLAVES — copia este archivo como .env y rellena los valores
#  NUNCA subas el archivo .env a GitHub (ya está en .gitignore)
# ─────────────────────────────────────────────────────────────

# 1) POEMA DEL DÍA — necesitas UNA de las dos (no las dos)
#
#    OPCIÓN GRATIS · Gemini, nivel gratuito, sin tarjeta
#    https://aistudio.google.com/apikey  →  "Create API key"
#    ⚠️ En el nivel gratuito Google usa lo que envías para entrenar sus
#       modelos. Aquí solo mandamos peticiones de poemas, así que no importa,
#       pero no reutilices esta llave para nada confidencial.
GEMINI_API_KEY=

#    OPCIÓN DE PAGO · Claude, ~$0.19 USD/mes de consumo real
#    https://console.anthropic.com  →  Get API Keys
#    Si pones esta, tiene prioridad sobre la de Gemini.
ANTHROPIC_API_KEY=

# 2) PUBLICACIÓN EN TIKTOK — https://www.upload-post.com (Settings > API Keys)
#    Requiere plan Basic ($16/mes). TikTok no está en el plan gratuito.
UPLOADPOST_API_KEY=
UPLOADPOST_USER=mi-perfil          # el nombre del perfil que conectaste a TikTok

# 3) OPCIONAL — Música de fondo con IA. https://elevenlabs.io (Profile > API Key)
ELEVENLABS_API_KEY=

# ── Ajustes ────────────────────────────────────────────────────
ZONA_HORARIA=America/Mexico_City
# PUBLICAR=false  -> genera el video pero NO lo sube (útil para probar)
PUBLICAR=true
